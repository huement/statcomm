{
    "name": "huement/statcomm",
    "autoload": {
        "psr-4": {
            "Huement\\StatComm\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Huement\\StatComm\\Tests\\": "tests/"
        }
    },
    "require": {
        "statamic/cms": "^6.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "orchestra/testbench": "^10.0",
        "livewire/livewire": "^3.0"
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true,
            "pestphp/pest-plugin": true
        }
    },
    "license": "MIT",
    "extra": {
        "statamic": {
            "name": "StatComm",
            "description": "StatComm addon"
        },
        "laravel": {
            "providers": [
                "Huement\\StatComm\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
